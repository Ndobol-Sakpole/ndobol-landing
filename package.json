{
  "name": "ndobol-landing",
  "version": "1.0.0",
  "private": true,
  "description": "Promotional website and playtest signup for Ndobol Sesarengan",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": "24.x"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Ndobol-Sakpole/ndobol-landing.git"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env --watch backend/server.js",
    "start": "node --env-file-if-exists=.env backend/server.js",
    "build": "node --env-file-if-exists=.env infra/build.js",
    "test": "node --test tests/*.test.js",
    "db:migrate": "node --env-file-if-exists=.env infra/migrate.js",
    "check": "npm test && npm run build"
  },
  "dependencies": {
    "@neondatabase/serverless": "1.2.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.11"
  }
}
