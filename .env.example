# Public build settings. Empty GAME_URL uses the official demo below.
# https://ndobol-game-teal.vercel.app/apps/web/index.html
GAME_URL=
SITE_URL=

# Neon Postgres connection string. Required for playtest signup on Vercel.
# Set this in Vercel Environment Variables; never put it in frontend files.
DATABASE_URL=

# Local development only. Without DATABASE_URL, use SQLite at this path.
PLAYTEST_DATABASE_PATH=storage/playtest.sqlite
HOST=127.0.0.1
PORT=4173
